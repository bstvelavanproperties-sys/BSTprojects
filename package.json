{
  "name": "bst-velavan-properties",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "predev": "node scripts/free-ports.js",
    "dev": "concurrently -n CLIENT,API -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "assets": "npm run assets --workspace client",
    "sitemap": "npm run sitemap --workspace client",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "check": "npm run lint --workspace client && npm run check --workspace server",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
