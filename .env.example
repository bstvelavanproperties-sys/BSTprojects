# Copy to .env for local development. NEVER commit .env — it is gitignored.
# The deployed values live in the Vercel and Render dashboards, not here.
#
# ONE file for the whole repo, read by both workspaces:
#   • the API      — server/src/config/loadEnv.js
#   • Vite         — envDir in client/vite.config.js
#   • the sitemap  — client/scripts/make-sitemap.js
# All three point at this file explicitly, because npm runs each workspace with its
# own directory as the cwd and the default lookup would miss it.
#
# Local development needs almost none of this: with an empty file the API runs in
# memory mode with demo fixtures and an open admin panel. Production is strict —
# server/src/config/env.js refuses to start if anything below marked REQUIRED is missing.

PORT=5000

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (on Render).
# SITE_ORIGIN is the public address of the SITE (Vercel / your domain), not the API.
# It drives canonical URLs, WhatsApp share previews and sitemap.xml.
SITE_ORIGIN=http://localhost:5173

# REQUIRED IN PRODUCTION (on Render).
# Browser origins allowed to call the API. Because the frontend is on Vercel and the
# API is on Render, these are different origins and this is a real security boundary.
# Comma-separated, no trailing slashes.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Where the browser bundle sends /api requests.
#   Local: leave BLANK so Vite proxies /api to localhost:5000.
#   Vercel: set to the Render API origin, e.g. https://api.bstvelavanproperties.com
#
# Getting this wrong on Vercel means every API call 404s. It will be obvious — the
# site now reports "Listings are unavailable" rather than quietly showing demo data.
#
# If you change it, update connect-src in client/vercel.json to match, or the browser's
# CSP will block the requests.
#
# make-sitemap.js also reads it, to list published listings at build time without
# needing database credentials in the Vercel build.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Database — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Percent-encode the password if it contains @ : / ? # [ ] or %.
# Lock the Atlas IP allowlist to Render's static outbound IPs — never 0.0.0.0/0.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Admin sign-in — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Production rejects passwords under 12 characters and any known/default password.
# /admin is named in robots.txt and gets scanned within hours of a domain going live.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# REQUIRED IN PRODUCTION. Signs admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset locally and a random one is generated per restart.
# Never ship without it: the fallback derives the key from ADMIN_PASSWORD, so a
# single leaked token can be brute-forced offline to recover the password itself.
SESSION_SECRET=

# Optional alternative to username/password, for scripted imports. Long and random.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Cloudinary — optional, but all three or none
# ---------------------------------------------------------------------------
# Also set a max file size in the Cloudinary console (Settings → Upload). The upload
# API has no max_file_size parameter, so that console setting is the only real
# ceiling — the limits in the browser are UX, not enforcement.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Optional Google Analytics 4. Baked into the bundle at build time.
# ---------------------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=
