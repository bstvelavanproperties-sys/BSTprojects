# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB is optional. Leave blank to run in memory mode (seed data, no persistence).
MONGODB_URI=

# Demo-grade gate on write endpoints. Leave blank to disable (zero-config demo).
# NOT authentication — replace with real login before the client manages live inventory.
ADMIN_TOKEN=

# Lead notification email (https://resend.com — free tier). Optional.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=onboarding@resend.dev

# Cloudinary unsigned upload for property images. Optional — admin falls back to URL paste.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=

# Google Analytics 4. Optional.
VITE_GA_MEASUREMENT_ID=

# Public site origin, used for canonical URLs and share previews.
SITE_ORIGIN=http://localhost:5000
